# Основная база данных
DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5432/wallet_db

# Отдельная база для pytest, чтобы прогон тестов не трогал рабочие данные.
# Если не задать — тесты используют DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5432/wallet_test

# Локальный веб-интерфейс на /ui (в проде обычно выключают)
SERVE_UI=true

# Rate limiting: скользящее окно на клиента (по токену, иначе по IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Метрики Prometheus на /metrics
METRICS_ENABLED=true

LOG_LEVEL=INFO
